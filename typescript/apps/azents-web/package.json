{
  "name": "@azents/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3003",
    "build": "next build",
    "start": "next start",
    "test": "node --experimental-strip-types --test 'src/**/*.test.mts'",
    "storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook dev -p 6006",
    "build-storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook build",
    "lint": "eslint src .storybook --max-warnings 0 --cache --cache-strategy content",
    "lint:fix": "eslint src .storybook --max-warnings 0 --fix --cache --cache-strategy content",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write --cache 'src/**/*.{ts,tsx,mts}' '.storybook/**/*.{ts,tsx}' 'messages/**/*.json'",
    "format:check": "prettier --check --cache 'src/**/*.{ts,tsx,mts}' '.storybook/**/*.{ts,tsx}' 'messages/**/*.json'"
  },
  "dependencies": {
    "@azents/public-client": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@mantine/charts": "9.5.1",
    "@mantine/core": "^9.5.1",
    "@mantine/form": "^9.5.1",
    "@mantine/hooks": "^9.5.1",
    "@mantine/modals": "^9.5.1",
    "@sentry/nextjs": "^10.70.0",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-query": "^5.101.4",
    "@trpc/client": "^11.18.0",
    "@trpc/react-query": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "geist": "^1.7.2",
    "lang-map": "^0.4.0",
    "mermaid": "^11.16.1",
    "next": "16.2.11",
    "next-intl": "^4.13.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "recharts": "3.10.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "superjson": "^2.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@next/eslint-plugin-next": "^16.3.1",
    "@storybook/addon-a11y": "^10.5.8",
    "@storybook/addon-docs": "^10.5.8",
    "@storybook/addon-themes": "^10.5.8",
    "@storybook/nextjs-vite": "^10.5.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/react-syntax-highlighter": "^15.5.13",
    "eslint": "^10.8.1",
    "eslint-config-next": "^16.3.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-perfectionist": "^5.10.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.5.26",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "storybook": "^10.5.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
