  "dependencies": {
    "@azents/admin-client": "workspace:*",
    "@azents/public-client": "workspace:*",
    "@mantine/core": "9.5.2",
    "@mantine/form": "9.5.2",
    "@mantine/hooks": "9.5.2",
    "@mantine/modals": "9.5.2",
    "@mantine/notifications": "9.5.2",
    "@refinedev/core": "^5.0.12",
    "@refinedev/nextjs-router": "^7.0.5",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-query": "^5.102.8",
    "@trpc/client": "^11.18.0",
    "@trpc/react-query": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "dayjs": "^1.11.21",
    "next": "16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "superjson": "^2.2.6",
    "zod": "^4.4.3"
