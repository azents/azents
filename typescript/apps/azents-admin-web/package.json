{
  "name": "@azents/admin-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3002",
    "build": "next build",
    "start": "next start",
    "test": "node --experimental-strip-types --test 'src/**/*.test.mts'",
    "lint": "eslint src --max-warnings 0 --cache --cache-strategy content",
    "lint:fix": "eslint src --max-warnings 0 --fix --cache --cache-strategy content",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write --cache 'src/**/*.{ts,tsx}'",
    "format:check": "prettier --check --cache 'src/**/*.{ts,tsx}'"
