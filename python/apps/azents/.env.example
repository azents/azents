# Azents environment variable examples
# Copy this file to .env before use

# Runtime environment (local, deployed)
AZ_RUNTIME_ENV=local

# Sentry DSN (optional, for error tracking)
# AZ_SENTRY_DSN=

# PostgreSQL configuration
# For local development: docker compose -f docker-compose.azents.yaml up -d
AZ_RDB_HOST=localhost
AZ_RDB_PORT=5433
AZ_RDB_USER=azents
AZ_RDB_PASSWORD=azents
AZ_RDB_DB_NAME=azents

# AWS RDS IAM authentication (production; False for local development)
AZ_RDB_USE_IAM_AUTH=False
# AZ_RDB_REGION=us-west-2
# AZ_RDB_SSL_MODE=require

# JWT secret (development only; use a secure key in production)
AZ_AUTH_JWT_SECRET_KEY=dev-secret-key-change-in-production

# LLM credential encryption key (Fernet key, 32 bytes encoded as base64)
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AZ_CREDENTIAL_ENCRYPTION_KEY=bfIsUUPaUYXEygZKaJgJPXc5VJylRYqqI5zc8REYLtY=

# Session data S3 storage (RustFS)
# Start RustFS with docker compose -f docker-compose.azents.yaml up -d
AZ_WORKSPACE_S3_BUCKET=azents-dev
AZ_WORKSPACE_S3_ENDPOINT_URL=http://localhost:9000

# Sandbox - File Gateway sidecar (default: azents-file-gateway:local; empty to disable)
# Sandbox creation automatically builds the file-gateway image and starts the sidecar
# AZ_SANDBOX_FILE_GATEWAY_IMAGE=azents-file-gateway:local
AZ_SANDBOX_FILE_GATEWAY_STORAGE_BACKEND=s3
AZ_SANDBOX_FILE_GATEWAY_S3_BUCKET=azents-dev
AZ_SANDBOX_FILE_GATEWAY_S3_ENDPOINT_URL=http://host.docker.internal:9000

# Frontend URL (OAuth redirects and related flows)
AZ_WEB_URL=https://localhost:3003

# API server public URL (OAuth redirect callbacks)
AZ_API_URL=http://localhost:8000
AZ_EXTERNAL_CHANNEL_SLACK_CALLBACK_URL=http://localhost:8000/external-channel/v1/slack/events
# Enable only after every API and worker instance is mode-aware.
# AZ_EXTERNAL_CHANNEL_MULTI_APP_ENABLED=False

# Redis (Valkey) configuration
AZ_REDIS_URL=redis://localhost:6379

# GitHub Platform App (JWT — exchange for Installation Access Tokens)
AZ_GITHUB_PLATFORM_APP_ID=
AZ_GITHUB_PLATFORM_PRIVATE_KEY=

# GitHub Platform App (OAuth — list Installations)
AZ_GITHUB_PLATFORM_CLIENT_ID=
AZ_GITHUB_PLATFORM_CLIENT_SECRET=

# Sandbox control (local devserver)
AZ_AGENT_HOME_SANDBOX_CONTROL_ENDPOINT=localhost:8020
AZ_AGENT_HOME_SANDBOX_CONTROL_AUTH_SECRET=dev-sandbox-control-auth-secret
AZ_SANDBOX_CONTROL_PORT=8020
AZ_SANDBOX_CONTROL_INSTANCE_ID=azents-devserver-local
AZ_SANDBOX_CONTROL_AUTH_SECRET=dev-sandbox-control-auth-secret

# Per-session sandbox lifecycle TTL (Phase 5)
# - hibernate idle: inactivity before container hibernation (default 1800 = 30 minutes)
# - snapshot TTL: time after hibernation before snapshot deletion (default 86400 = 1 day)
# - EFS TTL: time after expiry before deleting /home/sandbox EFS subPath (default 2592000 = 30 days)
# AZ_AZENTS_SESSION_HIBERNATE_IDLE_SECONDS=1800
# AZ_AZENTS_SESSION_SNAPSHOT_TTL_SECONDS=86400
# AZ_AZENTS_SESSION_EFS_TTL_SECONDS=2592000
