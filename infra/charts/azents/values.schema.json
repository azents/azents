                    "properties": {
                      "repository": {
                        "minLength": 1
                      },
                      "tag": {
                        "minLength": 1
                      }
                    },
                    "required": [
                      "repository",
                      "tag"
                    ]
                  }
                },
                "required": [
                  "image"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
