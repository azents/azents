            ]
          }
        },
        "required": [
          "objectStorage"
        ]
      },
      "then": {
        "properties": {
          "objectStorage": {
            "properties": {
              "external": {
                "properties": {
                  "bucket": {
                    "minLength": 1
                  }
                },
                "required": [
                  "bucket"
                ]
              }
            },
            "required": [
              "external"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "objectStorage": {
            "properties": {
